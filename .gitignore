node_modules
dist
dist-ssr
*.local

# env files (server-side secrets: NVD_API_KEY, ABUSECH_AUTH_KEY)
.env
.env.*
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea
.claude

.DS_Store

# GitHub intel: disk-backed cache of discovered/enriched repos (expensive to
# rebuild given GitHub's free-tier rate limits -- see server/githubIntel/store.js)
server/githubIntel/.cache

# AI Daily Brief: rolling daily malware-trend snapshots -- see server/malwareTrendHistory.js
# Normally excluded (regenerated by background jobs at runtime), except for a
# one-time demo seed snapshot committed for the DigitalOcean deploy, so a
# fresh instance starts pre-populated instead of empty -- see the commit that
# added these. rag-index.json stays excluded: it's the RAG chatbot's
# embedding index (17MB+) and that tab is intentionally disabled on the demo
# deploy (no Ollama there), so seeding it would add nothing but build time.
server/.cache/*
!server/.cache/actor-trend-history.json
!server/.cache/ai-threat-summaries.json
!server/.cache/attack-technique-mentions.json
!server/.cache/campaign-intelligence.json
!server/.cache/darkweb-intelligence.json
!server/.cache/ioc-extraction-metrics.json
!server/.cache/ioc-intelligence.json
!server/.cache/malware-intelligence.json
!server/.cache/malware-trend-history.json
!server/.cache/remediation-tracker.json
!server/.cache/source-reliability-history.json
!server/.cache/threat-actor-intelligence.json
!server/.cache/threat-score-history.json
!server/.cache/tool-intelligence.json
!server/.cache/watchlist.json

# scripts/restart-backend.ps1's own rolling output -- timestamped per run, pruned to 7 days by the script itself
logs/
